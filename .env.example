# Server & Runtime
PORT=3000
NODE_ENV=production

# Neon PostgreSQL Database Connection (Required when using Neon / PostgreSQL)
# Pooled connection string (-pooler) for Express runtime traffic:
DATABASE_URL=""
# Direct (unpooled) connection string for initial table setup / migrations (optional, falls back to DATABASE_URL):
DATABASE_URL_UNPOOLED=""

# Uploaded Receipts Storage Path (mount a Dokploy volume to /app/data; also stores local JSON fallback if DATABASE_URL is unset)
DATA_DIR=./data

# Authentication Signing Secret (set a persistent 32+ char random string in Dokploy)
AUTH_JWT_SECRET=""

# Public App URL & optional extra allowed origins (comma-separated) for proxy/CSRF checks
APP_URL="https://kas.domainanda.com"
ALLOWED_ORIGINS=""

# Optional Admin Setup Passcode (requires this code during initial first-run setup if non-empty)
ADMIN_BOOTSTRAP_PASSCODE=""

# Optional server-side Bearer/Fonnte token for WhatsApp gateway dispatch
WHATSAPP_API_TOKEN=""

# Optional Gemini API key (if AI features are configured)
GEMINI_API_KEY=""
